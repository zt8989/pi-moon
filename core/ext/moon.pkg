// pi 扩展：发现、体检、缓存、启动前打包，以及宿主进程（bun）的 RPC。
//
// 形状照 magpie：主程序不嵌 JS 引擎，扩展跑在独立的 bun 进程里，两边按行
// 说 JSON。于是 TypeScript 转译、npm 解析、Node API 都由 bun 那边负责，
// MoonBit 侧只剩「发现 / 体检 / 缓存 / 起进程 / 说话」。
//
// 关键约束（决定了本包不存在的东西）：
//   - 不嵌 JS 引擎：没有 wasm 运行时、没有快照、没有 host_call 桥；
//   - 打包只发生在缓存未命中时（Bun.build），产物按内容哈希落盘；
//   - 文件系统访问走扩展侧的策略模块按「cwd / agent 目录 / 临时目录」白名单卡。

import {
  "pi-moon/core/sys",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
}

supported_targets = "js+native"

warnings = "-79-67"

import {
  "moonbitlang/async",
  "moonbitlang/async/fs",
  "moonbitlang/core/random",
} for "wbtest"

// 发现与缓存都摸真实文件系统，测试只在 native 上跑。
options(
  targets: {
    "ext_wbtest.mbt": [ "native" ],
    "host_wbtest.mbt": [ "native" ],
  },
)
