// 内置工具：定义（发给模型的 schema）、启用状态（与 pi 的 defaultTools 同语义）、
// 以及真正执行它们的 async 实现。
//
// 这一层刻意不依赖 runtime / provider：它只知道 message（工具调用与结果）与
// action（PromptToolDefinition）。于是「谁执行工具」是 provider 的 effect 表的事，
// 而「有哪些工具、默认开哪些」可以单独测试。

import {
  "zhouteng/pi_moon/core/action",
  "zhouteng/pi_moon/core/message",
  "moonbitlang/async",
  "moonbitlang/async/fs",
  "moonbitlang/async/shell",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
  "moonbitlang/core/encoding/base64",
  "moonbitlang/core/encoding/utf8",
}

supported_targets = "+native"

warnings = "-79-67"
