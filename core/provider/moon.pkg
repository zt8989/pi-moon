import {
  "pi-moon/core/common",
  "pi-moon/core/message",
  "pi-moon/core/compact",
  "pi-moon/core/action",
  "pi-moon/core/state",
  "pi-moon/core/runtime",
  "pi-moon/core/tools",
  "conglinyizhi/moonbit-llm-faceoff" @faceoff,
  "moonbitlang/async",
  "moonbitlang/async/http",
  "moonbitlang/async/fs",
  "moonbitlang/core/json",
  "moonbitlang/core/env",
}

warnings = "-79-67"

// 提供方按 OpenAI 兼容线格式工作，配置格式直接读 pi 的那三份文件：
//   <agent dir>/models.json   provider / baseUrl / api / 模型目录 / 可选 apiKey
//   <agent dir>/auth.json     provider → { type: "api_key", key }
//   <agent dir>/settings.json defaultProvider / defaultModel / defaultThinkingLevel
//
// agent dir 与 pi 同址（PI_CODING_AGENT_DIR，缺省 ~/.pi/agent）。两边共用同一份
// 配置，改一次两处都生效 —— 这是「兼容 pi 的配置」的全部含义。

import {
  "pi-moon/core/loop",
} for "wbtest"

supported_targets = "+native"
